{
  "name": "@stricahq/cip08",
  "version": "2.0.0",
  "description": "Cardano CIP-8 message signing: verify CIP-30 signData output, or build and sign COSE_Sign1 messages",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.min.js",
  "jsdelivr": "./dist/index.min.js",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "data signing",
    "message signing",
    "signature",
    "strica",
    "cardano",
    "cip08",
    "cip-8",
    "cip-30",
    "cose"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/StricaHQ/cip08.git"
  },
  "bugs": {
    "url": "https://github.com/StricaHQ/cip08/issues"
  },
  "homepage": "https://github.com/StricaHQ/cip08#readme",
  "scripts": {
    "docs": "rm -rf docs && typedoc",
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.src.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepack": "yarn build",
    "prepublishOnly": "yarn build && yarn test",
    "test": "vitest run"
  },
  "author": "Strica",
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@stricahq/bip32ed25519": "^2.0.0",
    "@stricahq/cbors": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md",
    "package.json"
  ]
}
